POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DB_ENV=LOCAL
DB_URL=jdbc:postgresql://postgres:5432/postgres
DB_USER_USERNAME=postgres
DB_USER_PASSWORD=postgres
DB_ADMIN_USERNAME=postgres
DB_ADMIN_PASSWORD=postgres

SERG_HENDELSER_URL=http://serg-mock:8084/v1
SERG_FORMUEOBJEKT_URL=http://serg-mock:8084/v1
SERG_MOCK_HTTP_PORT=8084

RUN_HENDELSE_SYNC=true
RUN_FORMUEOBJEKT_SYNC=true

#kafka-light kjører i docker på samme maskin
KAFKA_BROKER_URL=http://host.docker.internal:8081
KAFKA_BROKER_SCOPE=local:local:matrikkel-kafka-light